# SafeReturn environment variables — TEMPLATE ONLY.
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# `.env.local` is ignored by git. NEVER put real values in this file
# (.env.example is committed to GitHub and is public to anyone with repo access).
#
# In GitHub Codespaces you can instead add these as Codespaces secrets
# (GitHub → Settings → Codespaces → Secrets). In Vercel, add them under
# Project → Settings → Environment Variables, separately for each environment.

# ---------------------------------------------------------------------------
# Used in Phase P0
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (POOLED endpoint — the host contains "-pooler").
# Find it in the Neon console → your project → Connect. Use the `dev` branch for
# local development. Leave empty until you have created the Neon project; the app
# still starts and /api/health reports the database as "not_configured".
# Format: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Public base URL of the app (no trailing slash).
APP_BASE_URL=http://localhost:3000

# Which message channel to use: "fake" (prints messages to the terminal, sends
# nothing) or "whatsapp". Defaults to "fake" outside production. Production
# must set "whatsapp"; "fake" is refused there so real alerts can't be swallowed.
MESSAGE_CHANNEL=fake

# ---------------------------------------------------------------------------
# Reserved for later phases — listed so names stay consistent.
# Do not fill these in yet; nothing reads them in P0.
# ---------------------------------------------------------------------------

# P1: direct (non-pooled) Neon connection, used only for running migrations.
# DATABASE_URL_UNPOOLED=

# P2: login-code delivery adapter (dev_inbox | whatsapp)
# OTP_DELIVERY=dev_inbox

# WhatsApp Business Cloud API (Meta). Only needed when MESSAGE_CHANNEL=whatsapp.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_API_VERSION=v24.0
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# P1/P4: shared secret required by /api/jobs/tick (Vercel Cron sends it automatically).
# CRON_SECRET=

# P2: application secrets (generate with: openssl rand -base64 32)
# SESSION_SECRET=
# OTP_PEPPER=

# P6: location share links
# SHARE_LINK_PEPPER=

# P8: error monitoring
# SENTRY_DSN=
